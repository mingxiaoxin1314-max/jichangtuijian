---
import Layout from '../layouts/Layout.astro';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  title="404 - 页面未找到 | 2026 机场推荐与评测"
  description="抱歉，您访问的页面不存在或已被移除。您可以返回首页或查看 2026 最新机场评测榜单。"
>
  <div class="max-w-3xl mx-auto px-4 py-20 text-center">
    <div class="inline-flex items-center justify-center w-20 h-20 rounded-3xl bg-blue-100 dark:bg-blue-950/80 text-blue-600 dark:text-blue-400 font-black text-3xl mb-6 shadow-md shadow-blue-500/10">
      404
    </div>
    <h1 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight mb-4">
      抱歉，您寻找的页面不存在
    </h1>
    <p class="text-base text-slate-600 dark:text-slate-400 max-w-md mx-auto mb-8 leading-relaxed">
      该页面可能已被移动、更名或链接已过期。请点击下方按钮返回首页，或直接查阅 2026 最新专线梯子排行榜。
    </p>

    <div class="flex flex-wrap items-center justify-center gap-4">
      <a
        href={`${baseUrl}/`}
        class="px-6 py-3 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm shadow-md shadow-blue-500/25 transition-all hover:scale-105 active:scale-95"
      >
        返回博客首页
      </a>
      <a
        href={`${baseUrl}/#ranking`}
        class="px-6 py-3 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 font-semibold text-sm transition-all"
      >
        查看 Top 9 机场评测
      </a>
    </div>
  </div>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import AirportCard from '../components/AirportCard.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import FAQ from '../components/FAQ.astro';
import { airportList } from '../data/airports';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

// 4 篇精选核心技术指南
const featuredPosts = [
  {
    title: "2026 新手科学选购网络专线避坑指南：告别虚标与年付陷阱",
    desc: "新手必读基准：深度拆解低价虚标套路、跑路小作坊特征，为什么坚持月付是最佳自保手段，以及如何制定合理的网络预算。",
    href: `${baseUrl}/posts/2026-beginner-guide/`,
    tag: "选型避坑",
    icon: "01",
    readTime: "6 分钟"
  },
  {
    title: "IEPL 与 IPLC 内网专线技术深度科普：为什么晚高峰从不拥堵？",
    desc: "深入底层网络架构：公网直连、BGP 隧道与点对点内网物理专线差异，从计算机网络与电信 QoS 流量整形揭秘抗抖动真相。",
    href: `${baseUrl}/posts/iepl-vs-iplc-guide/`,
    tag: "网络底层",
    icon: "02",
    readTime: "8 分钟"
  },
  {
    title: "Clash Verge Rev 与 Sing-box 客户端从零到精通配置指南",
    desc: "现代代理客户端深度实操：通用订阅一键导入、Mihomo 内核切换、开启全局 TUN 虚拟网卡与杜绝 DNS 泄漏全套策略。",
    href: `${baseUrl}/posts/client-config-guide/`,
    tag: "实操配置",
    icon: "03",
    readTime: "7 分钟"
  },
  {
    title: "晚高峰网络测速与性能压力测试方法论：丢包率与抖动为什么比带宽更重要？",
    desc: "专业工程师压测模型：32 线程持续并发测试、Jitter 抖动方差计算公式，以及判断原生双 ISP 纯净住宅 IP 的全套检验方案。",
    href: `${baseUrl}/posts/speedtest-methodology/`,
    tag: "基准测试",
    icon: "04",
    readTime: "9 分钟"
  }
];

// 开源客户端工具快速索引
const clientTools = [
  { name: "Clash Verge Rev", desc: "跨平台 Mihomo 内核 GUI，支持现代代理与 TUN 模式", platform: "Win / Mac / Linux", badge: "主流推荐" },
  { name: "Sing-box", desc: "新一代全能网络代理通用平台，性能极限抗抖动", platform: "全平台通用", badge: "高性能" },
  { name: "Shadowrocket", desc: "iOS 端经典规则分流代理工具，长连接保活稳定", platform: "iOS / iPadOS", badge: "移动端标配" },
  { name: "v2rayN", desc: "Windows 端成熟稳定的老牌代理客户端，极简轻便", platform: "Windows", badge: "轻量易用" }
];

// Schema.org ItemList 结构化数据 (大幅提升搜索引擎富文本展现)
const schemaItemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "2026 跨境网络专线知识库与性能基准榜单",
  "description": "基于晚高峰 32 线程压测的优质专线节点综合评测与推荐",
  "numberOfItems": airportList.length,
  "itemListElement": airportList.map((item) => ({
    "@type": "ListItem",
    "position": item.rank,
    "name": `${item.name} (${item.lineType})`,
    "description": item.description || `${item.badge} · ${item.planDesc}`,
    "url": `https://mingxiaoxin1314-max.github.io/jichangtuijian/airports/${item.id}/`
  }))
};
---

<Layout
  title="2026 机场推荐与梯子推荐知识库 | 高速节点与稳定科学上网评测指南"
  description="2026 稳定高速翻墙梯子与机场推荐基准实验室：基于晚高峰 32 线程压测数据，提供 IPLC/IEPL 物理专线测评、科学上网高速节点测速及主流开源客户端（Clash/Sing-box）配置指南。"
  keywords="2026机场推荐, 梯子推荐, 高速节点, 稳定翻墙梯子, 科学上网节点, 机场评测, 稳定机场, 高速翻墙, IEPL专线, IPLC专线, VLESS, Hysteria2, 云界线, 大佬云, 优惠码"
>
  <!-- Schema.org 结构化数据 -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schemaItemList, null, 2)} />

  <!-- Hero Section: 定位为开源技术知识库与基准实验室 -->
  <section class="relative pt-12 pb-14 md:pt-16 md:pb-20 overflow-hidden border-b border-slate-200/80 dark:border-slate-800/80 bg-gradient-to-b from-blue-500/5 via-transparent to-transparent">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-100/80 dark:bg-blue-950/80 border border-blue-200 dark:border-blue-800 text-blue-700 dark:text-blue-300 text-xs font-semibold mb-6 shadow-sm">
        <span class="flex h-2 w-2 rounded-full bg-blue-600 dark:bg-blue-400 animate-pulse"></span>
        <span>网络性能实验室 · 2026 年度基准报告</span>
      </div>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-slate-900 dark:text-white leading-[1.18] max-w-4xl mx-auto">
        2026 稳定网络专线与<span class="bg-gradient-to-r from-blue-600 via-indigo-600 to-cyan-500 bg-clip-text text-transparent">机场梯子推荐</span>知识库<br />
        <span class="text-xl sm:text-3xl text-slate-700 dark:text-slate-300 font-bold block mt-2">
          高速科学上网节点评测与客户端配置指南
        </span>
      </h1>

      <p class="mt-5 text-sm sm:text-base md:text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto leading-relaxed">
        记录国际骨干网 BGP 路由演进、IEPL/IPLC 物理专线底层技术与晚高峰 32 线程并发压测数据，涵盖稳定翻墙梯子、高速科学上网节点实测与开源代理客户端配置，为开发者、出海企业与科研从业者提供客观选型参考。
      </p>

      <!-- 快速跳转中枢按钮 -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href={`${baseUrl}/#guides`}
          class="px-6 py-3 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs sm:text-sm shadow-lg shadow-blue-500/25 transition-all hover:scale-[1.02] flex items-center gap-2"
        >
          <span>查阅技术专栏与避坑指南</span>
          <svg width="16" height="16" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </a>
        <a
          href={`${baseUrl}/#clients`}
          class="px-6 py-3 rounded-xl bg-white dark:bg-slate-900 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 font-semibold text-xs sm:text-sm border border-slate-200 dark:border-slate-700 transition-all"
        >
          <span>主流客户端配置索引</span>
        </a>
        <a
          href={`${baseUrl}/#benchmark`}
          class="px-6 py-3 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 font-semibold text-xs sm:text-sm transition-all"
        >
          <span>查看实测对比榜单</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Section 1: 精选技术专栏与实操指南 (置顶在首屏下方) -->
  <section id="guides" class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10">
      <div>
        <div class="text-blue-600 dark:text-blue-400 text-xs font-bold tracking-wider uppercase mb-1">Knowledge Base</div>
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white">
          网络工程精选专栏与避坑科普
        </h2>
      </div>
      <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 max-w-md">
        由网络性能爱好者整理，拆解专线架构拓扑、流量整形特征与协议客户端的最佳工程实践。
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {featuredPosts.map((post) => (
        <a
          href={post.href}
          class="group p-6 rounded-3xl bg-white dark:bg-[#111625] border border-slate-200 dark:border-slate-800 hover:border-blue-500/60 dark:hover:border-blue-500/50 shadow-sm hover:shadow-lg transition-all duration-300 flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-bold bg-blue-50 text-blue-700 dark:bg-blue-950 dark:text-blue-300 border border-blue-200/60 dark:border-blue-800/60">
                {post.tag}
              </span>
              <span class="text-xs text-slate-400 font-mono">
                {post.readTime}
              </span>
            </div>
            <h3 class="text-lg font-bold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors leading-snug">
              {post.title}
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-2.5 leading-relaxed">
              {post.desc}
            </p>
          </div>

          <div class="pt-5 mt-4 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-xs font-semibold text-blue-600 dark:text-blue-400">
            <span>查阅技术全文</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Section 2: 主流客户端工具与配置导航 -->
  <section id="clients" class="py-14 bg-slate-100/60 dark:bg-slate-900/40 border-y border-slate-200/80 dark:border-slate-800/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <div class="text-blue-600 dark:text-blue-400 text-xs font-bold tracking-wider uppercase mb-1">Ecosystem & Tools</div>
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white">
          主流开源代理客户端配置与选型
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-2">
          推荐使用维护活跃、支持最新协议与虚拟 TUN 模式的现代代理工具。
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {clientTools.map((tool) => (
          <div class="p-5 rounded-2xl bg-white dark:bg-[#111625] border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-semibold px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
                  {tool.platform}
                </span>
                <span class="text-[11px] font-bold text-blue-600 dark:text-blue-400">
                  {tool.badge}
                </span>
              </div>
              <h3 class="text-base font-bold text-slate-900 dark:text-white">{tool.name}</h3>
              <p class="text-xs text-slate-500 dark:text-slate-400 mt-1.5 leading-relaxed">{tool.desc}</p>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800">
              <a
                href={`${baseUrl}/posts/client-config-guide/`}
                class="text-xs font-semibold text-blue-600 dark:text-blue-400 hover:underline flex items-center justify-between"
              >
                <span>查看配置教学</span>
                <span>→</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 3: 2026 年度专线性能基准与实测对比 (承接商业转化) -->
  <section id="benchmark" class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10">
      <div>
        <div class="text-blue-600 dark:text-blue-400 text-xs font-bold tracking-wider uppercase mb-1">Performance Benchmarks</div>
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white">
          2026 高速稳定节点与专线梯子性能基准榜单
        </h2>
      </div>
      <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 max-w-md">
        按晚高峰 32 线程吞吐、科学上网节点抗抖动方差、原生 IP 解锁质量及客单价多维度综合评分加权排序。点击品牌名查阅独立测速报告，点击右侧按钮直达官网。
      </p>
    </div>

    <!-- 品牌卡片列表 (AirportCard 内置 Base64 安全直达) -->
    <div class="space-y-4">
      {airportList.map((airport) => (
        <AirportCard airport={airport} />
      ))}
    </div>
  </section>

  <!-- Section 4: 参数与价格速查表 -->
  <section id="comparison" class="py-16 bg-slate-100/50 dark:bg-slate-900/30 border-y border-slate-200/80 dark:border-slate-800/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <div class="text-blue-600 dark:text-blue-400 text-xs font-bold tracking-wider uppercase mb-1">Quick Comparison</div>
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white">
          全品牌核心规格与专享立减速查
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-2">
          横向直观比对各品牌专线方案、主流传输协议、最低月费、官方立减口令与专属评测入口。
        </p>
      </div>

      <ComparisonTable />
    </div>
  </section>

  <!-- Section 5: 常见答疑 FAQ -->
  <section id="faq" class="py-16 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-10">
      <div class="text-blue-600 dark:text-blue-400 text-xs font-bold tracking-wider uppercase mb-1">Frequently Asked Questions</div>
      <h2 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white">
        常见疑问解答 (FAQ)
      </h2>
      <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-2">
        理清专线协议区别与日常使用技巧。
      </p>
    </div>

    <FAQ />
  </section>

  <!-- 优惠券复制提示浮层 -->
  <div
    id="copy-toast"
    class="fixed bottom-6 right-6 z-50 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none flex items-center gap-2.5 px-4 py-3 rounded-xl bg-slate-900 text-white dark:bg-blue-600 text-xs font-semibold shadow-xl"
  >
    <svg width="16" height="16" class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
    </svg>
    <span id="copy-toast-text">优惠券码已成功复制到剪贴板！</span>
  </div>

  <!-- 优惠券复制逻辑脚本 -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const copyButtons = document.querySelectorAll('.copy-coupon-btn');
      const toast = document.getElementById('copy-toast');
      const toastText = document.getElementById('copy-toast-text');
      let toastTimeout = null;

      copyButtons.forEach((btn) => {
        btn.addEventListener('click', async (e) => {
          e.stopPropagation();
          const coupon = btn.getAttribute('data-coupon');
          if (!coupon) return;

          try {
            await navigator.clipboard.writeText(coupon);
            showToast(`优惠码 [${coupon}] 已复制！`);
          } catch (err) {
            const input = document.createElement('input');
            input.value = coupon;
            document.body.appendChild(input);
            input.select();
            document.execCommand('copy');
            document.body.removeChild(input);
            showToast(`优惠码 [${coupon}] 已复制！`);
          }
        });
      });

      function showToast(message) {
        if (!toast || !toastText) return;
        toastText.textContent = message;
        toast.classList.remove('translate-y-20', 'opacity-0');
        toast.classList.add('translate-y-0', 'opacity-100');

        if (toastTimeout) clearTimeout(toastTimeout);
        toastTimeout = setTimeout(() => {
          toast.classList.remove('translate-y-0', 'opacity-100');
          toast.classList.add('translate-y-20', 'opacity-0');
        }, 2200);
      }
    });
  </script>
</Layout>

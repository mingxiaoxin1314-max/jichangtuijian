---
import Layout from '../layouts/Layout.astro';
import AirportCard from '../components/AirportCard.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import FAQ from '../components/FAQ.astro';
import { airportList } from '../data/airports';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const featuredPosts = [
  {
    title: "2026 新手科学选购网络专线避坑指南：告别虚标与年付陷阱",
    desc: "新手选购梯子前必读：深度拆解低价虚标套路、跑路机场特征，为什么月付是最佳自保手段，以及如何制定合理预算。",
    href: `${baseUrl}/posts/2026-beginner-guide/`,
    tag: "选购指南",
    icon: "01",
    readTime: "6 分钟"
  },
  {
    title: "IEPL 与 IPLC 内网专线技术深度科普：为什么晚高峰从不拥堵？",
    desc: "对比公网直连、BGP 隧道与点对点物理专线差异，从计算机网络与电信 QoS 流量整形机制揭秘专线抗抖动真相。",
    href: `${baseUrl}/posts/iepl-vs-iplc-guide/`,
    tag: "网络底层",
    icon: "02",
    readTime: "8 分钟"
  },
  {
    title: "Clash Verge Rev 与 Sing-box 客户端从零到精通配置指南",
    desc: "2026 现代化代理客户端实操：订阅一键导入、Mihomo 内核切换、开启全局 TUN 虚拟网卡与杜绝 DNS 泄漏策略。",
    href: `${baseUrl}/posts/client-config-guide/`,
    tag: "实操攻略",
    icon: "03",
    readTime: "7 分钟"
  },
  {
    title: "晚高峰网络测速与性能压力测试方法论：丢包率与抖动为什么比带宽更重要？",
    desc: "专业工程师视角：32 线程并发压测模型、Jitter 方差计算公式，以及判断原生双 ISP 住宅 IP 的全套检验方案。",
    href: `${baseUrl}/posts/speedtest-methodology/`,
    tag: "工程测试",
    icon: "04",
    readTime: "9 分钟"
  }
];
---

<Layout
  title="2026 最新机场推荐与评测排行榜 | 优质高速稳定翻墙梯子测评"
  description="精选 2026 年度稳定高速机场推荐，涵盖 IEPL/IPLC 专线、VLESS、Hysteria2 协议。实测 4K/8K 秒开、低延迟游戏加速、ChatGPT/Claude 原生解锁，附最新专属优惠券码。"
>
  <!-- Hero Section -->
  <section class="relative pt-12 pb-16 md:pt-20 md:pb-24 overflow-hidden border-b border-slate-200/80 dark:border-slate-800/80 bg-gradient-to-b from-blue-500/5 via-transparent to-transparent">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-100/80 dark:bg-blue-950/80 border border-blue-200 dark:border-blue-800 text-blue-700 dark:text-blue-300 text-xs font-semibold mb-6 shadow-sm">
        <span class="flex h-2 w-2 rounded-full bg-blue-600 dark:bg-blue-400 animate-pulse"></span>
        <span>2026 稳定专线节点横评与选购指南</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-slate-900 dark:text-white leading-[1.15] max-w-4xl mx-auto">
        2026 高速稳定<span class="bg-gradient-to-r from-blue-600 via-indigo-600 to-cyan-500 bg-clip-text text-transparent">机场梯子推荐</span>排行榜
      </h1>

      <!-- Subtitle -->
      <p class="mt-6 text-base sm:text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto leading-relaxed">
        基于多地宽带（电信/联通/移动/校园网）晚高峰实际压测，甄选 9 大具备真实 IEPL/IPLC 专线与优质原生住宅 IP 的服务商，全天候保障流畅出海。
      </p>

      <!-- Stats Grid -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-3xl mx-auto mt-10">
        <div class="p-4 rounded-2xl bg-white dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 shadow-sm">
          <div class="text-2xl sm:text-3xl font-black text-blue-600 dark:text-blue-400">9 大</div>
          <div class="text-xs text-slate-500 dark:text-slate-400 mt-1">旗舰服务商横评</div>
        </div>
        <div class="p-4 rounded-2xl bg-white dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 shadow-sm">
          <div class="text-2xl sm:text-3xl font-black text-emerald-600 dark:text-emerald-400">100%</div>
          <div class="text-xs text-slate-500 dark:text-slate-400 mt-1">纯专线/不过墙架构</div>
        </div>
        <div class="p-4 rounded-2xl bg-white dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 shadow-sm">
          <div class="text-2xl sm:text-3xl font-black text-purple-600 dark:text-purple-400">4K/8K</div>
          <div class="text-xs text-slate-500 dark:text-slate-400 mt-1">晚高峰秒开拖拽</div>
        </div>
        <div class="p-4 rounded-2xl bg-white dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 shadow-sm">
          <div class="text-2xl sm:text-3xl font-black text-amber-600 dark:text-amber-400">¥5.6 起</div>
          <div class="text-xs text-slate-500 dark:text-slate-400 mt-1">超高性价比月付</div>
        </div>
      </div>

      <!-- Quick Action Buttons -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a
          href={`${baseUrl}/#ranking`}
          class="px-6 py-3 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm shadow-lg shadow-blue-500/25 transition-all hover:scale-[1.02] active:scale-95 flex items-center gap-2"
        >
          <span>查看 Top 9 综合排名</span>
          <svg width="16" height="16" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </a>
        <a
          href={`${baseUrl}/#comparison`}
          class="px-6 py-3 rounded-xl bg-white dark:bg-slate-900 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 font-semibold text-sm border border-slate-200 dark:border-slate-700 transition-all"
        >
          <span>参数与价格速查表</span>
        </a>
        <a
          href={`${baseUrl}/#posts`}
          class="px-6 py-3 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 font-semibold text-sm transition-all"
        >
          <span>技术与避坑专栏</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Section 1: Airport Ranking List -->
  <section id="ranking" class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10">
      <div>
        <div class="text-blue-600 dark:text-blue-400 text-xs font-bold tracking-wider uppercase mb-1">Rankings & Reviews</div>
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white">
          2026 年度 Top 9 优质机场综合评测榜
        </h2>
      </div>
      <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 max-w-md">
        按综合稳定性、晚高峰速率、原生 IP 解锁质量及客单价多维度综合评分加权排序。点击品牌名或下方详情可查阅独立测速报告。
      </p>
    </div>

    <!-- Airport Card List -->
    <div class="space-y-4">
      {airportList.map((airport) => (
        <AirportCard airport={airport} />
      ))}
    </div>
  </section>

  <!-- Section 2: Comparison Table -->
  <section id="comparison" class="py-16 bg-slate-100/50 dark:bg-slate-900/30 border-y border-slate-200/80 dark:border-slate-800/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <div class="text-blue-600 dark:text-blue-400 text-xs font-bold tracking-wider uppercase mb-1">Quick Comparison</div>
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white">
          全品牌核心规格与专享优惠速查
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-2">
          横向直观比对各品牌专线方案、主流传输协议、最低月费、官方立减口令与专属评测入口。
        </p>
      </div>

      <ComparisonTable />
    </div>
  </section>

  <!-- Section 3: Technical Articles / Buyer's Guide Section -->
  <section id="posts" class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <div class="text-blue-600 dark:text-blue-400 text-xs font-bold tracking-wider uppercase mb-1">Technical Guides & Insights</div>
      <h2 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white">
        精选技术专栏与避坑科普
      </h2>
      <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-2">
        由一线网络工程师撰写，深度拆解专线架构、测速压测标准与多平台客户端配置秘籍。
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {featuredPosts.map((post) => (
        <a
          href={post.href}
          class="group p-6 rounded-3xl bg-white dark:bg-[#111625] border border-slate-200 dark:border-slate-800 hover:border-blue-500/60 dark:hover:border-blue-500/50 shadow-sm hover:shadow-lg transition-all duration-300 flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-bold bg-blue-50 text-blue-700 dark:bg-blue-950 dark:text-blue-300 border border-blue-200/60 dark:border-blue-800/60">
                {post.tag}
              </span>
              <span class="text-xs text-slate-400">
                {post.readTime}
              </span>
            </div>
            <h3 class="text-lg font-bold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors leading-snug">
              {post.title}
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-2.5 leading-relaxed">
              {post.desc}
            </p>
          </div>

          <div class="pt-5 mt-4 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-xs font-semibold text-blue-600 dark:text-blue-400">
            <span>阅读技术全文</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Section 4: FAQ -->
  <section id="faq" class="py-16 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 border-t border-slate-200/80 dark:border-slate-800/80">
    <div class="text-center mb-10">
      <div class="text-blue-600 dark:text-blue-400 text-xs font-bold tracking-wider uppercase mb-1">Frequently Asked Questions</div>
      <h2 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white">
        常见疑问解答 (FAQ)
      </h2>
      <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-2">
        帮助您快速理清专线协议区别与日常使用技巧。
      </p>
    </div>

    <FAQ />
  </section>

  <!-- Floating Toast Notification for Coupon Copy -->
  <div
    id="copy-toast"
    class="fixed bottom-6 right-6 z-50 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none flex items-center gap-2.5 px-4 py-3 rounded-xl bg-slate-900 text-white dark:bg-blue-600 text-xs font-semibold shadow-xl"
  >
    <svg width="16" height="16" class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
    </svg>
    <span id="copy-toast-text">优惠券码已成功复制到剪贴板！</span>
  </div>

  <!-- Coupon Copy Client Script -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const copyButtons = document.querySelectorAll('.copy-coupon-btn');
      const toast = document.getElementById('copy-toast');
      const toastText = document.getElementById('copy-toast-text');
      let toastTimeout = null;

      copyButtons.forEach((btn) => {
        btn.addEventListener('click', async (e) => {
          e.stopPropagation();
          const coupon = btn.getAttribute('data-coupon');
          if (!coupon) return;

          try {
            await navigator.clipboard.writeText(coupon);
            showToast(`优惠码 [${coupon}] 已复制！`);
          } catch (err) {
            const input = document.createElement('input');
            input.value = coupon;
            document.body.appendChild(input);
            input.select();
            document.execCommand('copy');
            document.body.removeChild(input);
            showToast(`优惠码 [${coupon}] 已复制！`);
          }
        });
      });

      function showToast(message) {
        if (!toast || !toastText) return;
        toastText.textContent = message;
        toast.classList.remove('translate-y-20', 'opacity-0');
        toast.classList.add('translate-y-0', 'opacity-100');

        if (toastTimeout) clearTimeout(toastTimeout);
        toastTimeout = setTimeout(() => {
          toast.classList.remove('translate-y-0', 'opacity-100');
          toast.classList.add('translate-y-20', 'opacity-0');
        }, 2200);
      }
    });
  </script>
</Layout>

---
import { airportList } from '../data/airports';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="overflow-x-auto rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#111625] shadow-sm">
  <table class="w-full text-left border-collapse text-xs sm:text-sm">
    <thead>
      <tr class="bg-slate-50 dark:bg-slate-900/80 border-b border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300 font-semibold uppercase tracking-wider text-[11px] sm:text-xs">
        <th class="py-3.5 px-4">排名</th>
        <th class="py-3.5 px-4">品牌名称</th>
        <th class="py-3.5 px-4">专线架构</th>
        <th class="py-3.5 px-4">支持协议</th>
        <th class="py-3.5 px-4">月均底价</th>
        <th class="py-3.5 px-4">专享优惠码</th>
        <th class="py-3.5 px-4 text-center">操作</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60 font-normal text-slate-700 dark:text-slate-300">
      {airportList.map((item) => (
        <tr class="hover:bg-slate-50/80 dark:hover:bg-slate-900/40 transition-colors">
          <td class="py-3.5 px-4 whitespace-nowrap">
            <span class={`inline-flex items-center justify-center w-6 h-6 rounded-md font-bold text-xs ${
              item.rank === 1
                ? 'bg-amber-500 text-white shadow-sm'
                : item.rank === 2
                ? 'bg-blue-600 text-white'
                : item.rank === 3
                ? 'bg-emerald-600 text-white'
                : 'bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300'
            }`}>
              {item.rank}
            </span>
          </td>
          <td class="py-3.5 px-4 font-bold text-slate-900 dark:text-white whitespace-nowrap">
            <div class="flex items-center gap-2">
              <a
                href={`${baseUrl}/airports/${item.id}/`}
                class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors flex items-center gap-1.5"
                title={`查看 ${item.name} 独立深度评测`}
              >
                <span>{item.name}</span>
                <span class="text-[10px] text-blue-500 hover:underline font-normal">→</span>
              </a>
              {item.badge && (
                <span class="text-[10px] hidden md:inline-block px-1.5 py-0.5 rounded bg-blue-50 text-blue-700 dark:bg-blue-950 dark:text-blue-300 border border-blue-200/60 dark:border-blue-800/60">
                  {item.badge.split('·')[1]?.trim() || item.badge}
                </span>
              )}
            </div>
          </td>
          <td class="py-3.5 px-4 whitespace-nowrap">
            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200">
              {item.lineType}
            </span>
          </td>
          <td class="py-3.5 px-4 whitespace-nowrap text-slate-600 dark:text-slate-400">
            {item.protocols}
          </td>
          <td class="py-3.5 px-4 font-semibold text-amber-700 dark:text-amber-400 whitespace-nowrap">
            {item.monthlyPrice}
          </td>
          <td class="py-3.5 px-4 whitespace-nowrap">
            <button
              type="button"
              class="copy-coupon-btn inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-slate-100 dark:bg-slate-800/80 hover:bg-blue-50 dark:hover:bg-blue-950/60 text-slate-800 dark:text-slate-200 hover:text-blue-600 dark:hover:text-blue-400 font-mono text-xs border border-dashed border-slate-300 dark:border-slate-700 transition-colors"
              data-coupon={item.couponCode}
              title="点击复制优惠码"
            >
              <span>{item.couponCode}</span>
              <svg width="12" height="12" class="w-3 h-3 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
              </svg>
            </button>
          </td>
          <td class="py-3.5 px-4 text-center whitespace-nowrap">
            <div class="inline-flex items-center gap-2">
              <a
                href={`${baseUrl}/airports/${item.id}/`}
                class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 transition-colors"
                title={`查看 ${item.name} 详情`}
              >
                <span>详情</span>
              </a>
              <a
                href={item.affUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-semibold bg-blue-600 hover:bg-blue-700 text-white transition-colors"
                title={`前往 ${item.name} 官网`}
              >
                <span>官网直达</span>
                <svg width="12" height="12" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                </svg>
              </a>
            </div>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogType?: 'website' | 'article';
}

const {
  title = "2026 最新机场推荐与评测排行榜 | 优质高速稳定翻墙梯子测评",
  description = "精选 2026 年度稳定高速机场推荐，涵盖 IEPL/IPLC 专线、VLESS、Hysteria2 协议。实测 4K/8K 秒开、低延迟游戏加速、ChatGPT/Claude 原生解锁，附最新专属优惠券码。",
  keywords = "机场推荐, 梯子推荐, 2026机场评测, 稳定机场, 高速翻墙, IEPL专线, IPLC专线, VLESS, Hysteria2, 云界线, 大佬云, 优惠码",
  ogType = "website"
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-CN" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}/favicon.svg`} />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={canonicalURL.href} />

    <!-- Open Graph / Social -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="2026 机场推荐测评指南" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Theme Initialization Script to avoid FOUC -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'dark'; // 默认采用专业深色主题
      })();

      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
      window.localStorage.setItem('theme', theme);
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50 text-slate-900 dark:bg-[#0b0f19] dark:text-slate-100 antialiased selection:bg-blue-600 selection:text-white">
    <!-- Top Announcement Bar -->
    <aside aria-label="公告通知" class="bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 text-white text-xs sm:text-sm font-medium py-2 px-4 text-center">
      <div class="max-w-7xl mx-auto flex items-center justify-center gap-2">
        <span class="inline-block px-2 py-0.5 rounded-full bg-white/20 text-white font-semibold text-[11px] tracking-wide uppercase">2026 实测</span>
        <span>全部节点已完成 4K/8K 晚高峰压测与 AI 流媒体解锁检验，各品牌专享立减券已更新！</span>
      </div>
    </aside>

    <!-- Header Navbar -->
    <header class="sticky top-0 z-50 backdrop-blur-md bg-white/80 dark:bg-[#0b0f19]/80 border-b border-slate-200/80 dark:border-slate-800/80 transition-colors">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <a href={`${baseUrl}/`} class="flex items-center gap-2.5 group">
            <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-blue-600 to-cyan-500 flex items-center justify-center text-white shadow-md shadow-blue-500/20 group-hover:scale-105 transition-transform">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" class="w-5 h-5 -rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
              </svg>
            </div>
            <div>
              <span class="font-bold text-lg tracking-tight bg-gradient-to-r from-slate-900 to-slate-700 dark:from-white dark:to-slate-300 bg-clip-text text-transparent">机场评测推荐</span>
              <span class="hidden sm:inline-block ml-2 text-xs font-semibold px-2 py-0.5 rounded-full bg-blue-100 text-blue-700 dark:bg-blue-950 dark:text-blue-300 border border-blue-200 dark:border-blue-800">2026 指南</span>
            </div>
          </a>
        </div>

        <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-600 dark:text-slate-300">
          <a href={`${baseUrl}/#guides`} class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">技术专栏</a>
          <a href={`${baseUrl}/#clients`} class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">客户端索引</a>
          <a href={`${baseUrl}/#benchmark`} class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">实测基准榜</a>
          <a href={`${baseUrl}/#comparison`} class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">规格速查表</a>
          <a href={`${baseUrl}/#faq`} class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">常见答疑</a>
          <a href={`${baseUrl}/about/`} class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">关于作者</a>
        </nav>

        <div class="flex items-center gap-3">
          <!-- Dark mode toggle -->
          <button
            id="theme-toggle"
            type="button"
            class="p-2 rounded-xl text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 focus:outline-none transition-colors"
            aria-label="切换明暗主题"
          >
            <!-- Sun icon -->
            <svg id="theme-toggle-light-icon" width="20" height="20" class="hidden w-5 h-5 text-amber-500" fill="currentColor" viewBox="0 0 20 20">
              <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" fill-rule="evenodd" clip-rule="evenodd"></path>
            </svg>
            <!-- Moon icon -->
            <svg id="theme-toggle-dark-icon" width="20" height="20" class="hidden w-5 h-5 text-slate-400" fill="currentColor" viewBox="0 0 20 20">
              <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
            </svg>
          </button>

          <!-- Quick Top1 CTA Button -->
          <button
            type="button"
            data-target="aHR0cHM6Ly85NjI1bW9mYW4wMS55dW5qaWV4aWFuYWZmLmNvbS8jLz9jb2RlPU9PWWhTajBM"
            class="hidden sm:inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-medium text-xs shadow-sm shadow-blue-500/30 transition-all hover:scale-[1.02] cursor-pointer"
            title="直达 Top 1 云界线官网"
          >
            <span>Top 1 专线直达</span>
            <svg width="14" height="14" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="mt-20 border-t border-slate-200 dark:border-slate-800/80 bg-white/50 dark:bg-[#070b14] py-12 text-sm text-slate-500 dark:text-slate-400">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
          <div class="md:col-span-2 space-y-3">
            <div class="flex items-center gap-2">
              <div class="w-7 h-7 rounded-lg bg-blue-600 flex items-center justify-center text-white">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" class="w-4 h-4 -rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                </svg>
              </div>
              <span class="font-bold text-slate-900 dark:text-white text-base">2026 机场推荐测评指南</span>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed max-w-md">
              本站致力于提供真实客观的跨境网络节点与专线加速服务实测数据，包含节点晚高峰测速、流媒体解锁测试与性价比分析。请合法合规使用网络。
            </p>
          </div>
          <div>
            <h3 class="font-semibold text-slate-900 dark:text-white text-xs uppercase tracking-wider mb-3">快捷导航</h3>
            <ul class="space-y-2 text-xs">
              <li><a href={`${baseUrl}/#guides`} class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">技术专栏与避坑</a></li>
              <li><a href={`${baseUrl}/#clients`} class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">开源客户端配置</a></li>
              <li><a href={`${baseUrl}/#benchmark`} class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">性能基准实测榜</a></li>
              <li><a href={`${baseUrl}/#comparison`} class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">核心规格横向对比</a></li>
              <li><a href={`${baseUrl}/#faq`} class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">常见问题 FAQ</a></li>
              <li><a href={`${baseUrl}/about/`} class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors font-medium text-blue-600 dark:text-blue-400">关于作者 & 评测实验室</a></li>
            </ul>
          </div>
          <div>
            <h3 class="font-semibold text-slate-900 dark:text-white text-xs uppercase tracking-wider mb-3">免责声明</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
              本站评测数据仅供学术交流与网络质量对比参考。优惠信息与节点状态可能随服务商变动，请以官方控制台实时数据为准。
            </p>
          </div>
        </div>

        <div class="pt-6 border-t border-slate-200 dark:border-slate-800 flex flex-col sm:flex-row items-center justify-between text-xs gap-3">
          <p>© 2026 机场推荐与评测. All rights reserved.</p>
          <div class="flex items-center gap-4">
            <span class="inline-flex items-center gap-1.5 text-emerald-600 dark:text-emerald-400">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              节点每日自动化连通监控中
            </span>
          </div>
        </div>
      </div>
    </footer>

    <!-- Dark Mode Toggle Script -->
    <script is:inline>
      const themeToggleDarkIcon = document.getElementById('theme-toggle-dark-icon');
      const themeToggleLightIcon = document.getElementById('theme-toggle-light-icon');
      const themeToggleBtn = document.getElementById('theme-toggle');

      function updateThemeIcons() {
        if (document.documentElement.classList.contains('dark')) {
          themeToggleLightIcon?.classList.remove('hidden');
          themeToggleDarkIcon?.classList.add('hidden');
        } else {
          themeToggleLightIcon?.classList.add('hidden');
          themeToggleDarkIcon?.classList.remove('hidden');
        }
      }

      updateThemeIcons();

      themeToggleBtn?.addEventListener('click', () => {
        if (document.documentElement.classList.contains('dark')) {
          document.documentElement.classList.remove('dark');
          localStorage.setItem('theme', 'light');
        } else {
          document.documentElement.classList.add('dark');
          localStorage.setItem('theme', 'dark');
        }
        updateThemeIcons();
      });

      // Global Dynamic Base64 Link Redirect Handler
      document.addEventListener('click', (e) => {
        const trigger = e.target.closest('[data-target]');
        if (!trigger) return;
        e.preventDefault();
        const b64 = trigger.getAttribute('data-target');
        if (b64) {
          try {
            const dest = atob(b64);
            const win = window.open(dest, '_blank', 'noopener,noreferrer');
            if (win) win.opener = null;
          } catch (err) {
            console.error('Target jump failed', err);
          }
        }
      });
    </script>
  </body>
</html>
